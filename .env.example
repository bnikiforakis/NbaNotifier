# Copy to .env and fill in. Never commit .env.

# PiButler gateway (reachable on the shared docker network)
PIBUTLER_URL=http://pibutler:8080
# Must match the nba-notifier entry in PiButler's PROJECT_KEYS
PIBUTLER_API_KEY=change-me
PIBUTLER_PROJECT_ID=nba-notifier

# Minutes before tip-off to send followers the reminder
REMINDER_MINUTES=30
# Seconds between live polls while a game is on
POLL_SECONDS=30

# Clock for the daily messages and the quiet hours
TIMEZONE=Europe/Athens
# Tonight's games (the US game day starting this evening), with Follow buttons
SCHEDULE_TIME=17:00
# Last night's results, one 📊 button per game
RESULTS_TIME=11:00
# Mondays: each followed team's games of the week (Monday to Sunday, US game days)
WEEKLY_TIME=13:00
# Followed-game messages are silent (no sound) in this window
QUIET_START=00:00
QUIET_END=09:00

# /nba command: PiButler calls this URL (internal docker network only; the port isn't published)
CALLBACK_URL=http://nba-notifier:8081/pibutler

DB_PATH=/data/nba_notifier.db
LOG_LEVEL=INFO
